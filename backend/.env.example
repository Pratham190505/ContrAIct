# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/contrAIct?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Service (Python FastAPI — Phase 2)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=replace-with-a-long-random-shared-secret

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# CORS
FRONTEND_URL=http://localhost:5173
