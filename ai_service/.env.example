# LLM
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-20b
LLM_REQUESTS_PER_MINUTE=20
LLM_MAX_BACKOFF_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=10

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=6
ANALYSIS_TOP_K=14
MAX_RETRY_ATTEMPTS=2

# Embeddings (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage — must match backend UPLOAD_DIR
UPLOAD_DIR=../backend/uploads
VECTORSTORE_BASE_DIR=vectorstores
CACHE_BASE_DIR=cache
LLM_LOG_DIR=logs

# Backend callback (Phase 1 backend URL)
BACKEND_URL=http://localhost:5000
AI_SERVICE_SECRET=replace-with-the-same-long-random-shared-secret
